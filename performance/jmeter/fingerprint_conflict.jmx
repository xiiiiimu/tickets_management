 <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="expect_conflict" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def code=prev.getResponseCode().toInteger(); if(!(code in [409,400,429])){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Expected fingerprint conflict, got '+code);}</stringProp></JSR223Assertion><hashTree/>
