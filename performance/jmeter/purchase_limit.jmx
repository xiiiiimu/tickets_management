 <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="reserve" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{"requestId":"perf-limit-${__UUID()}","userId":${userId},"eventSessionId":"${__P(sessionId,perf_session)}","ticketSkuId":"${__P(skuId,perf_sku_limit)}","quantity":1,"deviceId":"${deviceId}"}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${__P(host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,8082)}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/tickets/reserve</stringProp><stringProp name="HTTPSampler.method">POST</stringProp></HTTPSamplerProxy><hashTree>
 <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="contract" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def code=prev.getResponseCode().toInteger(); if(!(code in [200,409,429])){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('Unexpected '+code);}</stringProp></JSR223Assertion><hashTree/>
